# Copie este arquivo para .env e preencha os valores

# Chave da API da Anthropic (obtenha em https://platform.claude.com/)
ANTHROPIC_API_KEY=sk-ant-...

# OBRIGATÓRIO: segredo que assina o cookie de sessão — o servidor NÃO SOBE sem
# ele. Gere um valor aleatório com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Seed do PRIMEIRO admin: usados apenas quando a tabela de usuários está vazia
# (primeira execução). Alterar estes valores depois NÃO muda a senha no banco.
ADMIN_USER=unyflex
ADMIN_PASS=unyflex

# MySQL da Unyflex (central de dados) — usuário EXCLUSIVO com permissão apenas
# de SELECT nas tabelas classes, enrollments e students. Nunca escrita.
# Sem estas variáveis, a sincronização fica desabilitada (o resto funciona).
# MYSQL_HOST=
# MYSQL_PORT=3306
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=

# Em produção (atrás de HTTPS/proxy reverso), ative para o cookie sair `secure`:
# NODE_ENV=production

# Porta do servidor (opcional, padrão 8000)
# PORT=8000
