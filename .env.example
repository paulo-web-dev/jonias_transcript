# Copie este arquivo para .env e preencha os valores

# Chave da API da Anthropic (obtenha em https://platform.claude.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Credenciais de login do sistema
ADMIN_USER=unyflex
ADMIN_PASS=unyflex

# Segredo usado para assinar o cookie de sessão (troque por um valor aleatório)
SESSION_SECRET=troque-por-um-valor-aleatorio-longo

# Porta do servidor (opcional, padrão 8000)
# PORT=8000
